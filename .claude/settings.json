{
  "enabledPlugins": {
    "supabase@claude-plugins-official": false,
    "andrej-karpathy-skills@karpathy-skills": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/pretooluse-filter-npm.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
