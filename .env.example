# Copy this file to .env.local and fill in the keys you have.

# --- Supabase (required — the app has no database without these) ---
# Project Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only, never exposed to the client. Only used for admin tasks that
# deliberately bypass Row Level Security (none by default).
SUPABASE_SERVICE_ROLE_KEY=

# --- Postgres connection (Project Settings → Database → Connect) ---
# DATABASE_URL: transaction pooler (port 6543) — used by the app at runtime.
# DIRECT_URL: direct connection (port 5432) — used only by drizzle-kit migrations.
DATABASE_URL=
DIRECT_URL=

# --- Optional ---
# Enables real AI plan generation on the Generate page. Without it, the app
# falls back to a demo plan. Get a key at https://platform.claude.com/
ANTHROPIC_API_KEY=

# The exercise catalog is vendored in src/db/exercises.json (+ .es.json) — no key
# needed. Re-sync it from the WorkoutX API with scripts/sync-exercises.py, which
# is the only thing that reads this key.
WORKOUTX_API_KEY=
