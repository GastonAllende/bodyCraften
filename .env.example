# Copy this file to .env.local and fill in the keys you have.
# The app works without any keys (demo AI plans + built-in exercise catalog).

# Enables real AI plan generation on the Generate page.
# Get a key at https://platform.claude.com/
ANTHROPIC_API_KEY=

# Enables the full ExerciseDB catalog (1,300+ exercises) on the Exercises page.
# Subscribe (free tier) at https://rapidapi.com/justin-WFnsXH_t6/api/exercisedb
# and paste your X-RapidAPI-Key here.
EXERCISEDB_API_KEY=
