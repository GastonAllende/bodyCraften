# Copy this file to .env.local and fill in the keys you have.
# The app works without any keys (demo AI plans + built-in exercise catalog).

# Enables real AI plan generation on the Generate page.
# Get a key at https://platform.claude.com/
ANTHROPIC_API_KEY=

# The exercise catalog is vendored in src/db/exercises.json (+ .es.json) — no key
# needed. Re-sync it from the WorkoutX API with scripts/sync-exercises.py, which
# is the only thing that reads this key.
WORKOUTX_API_KEY=
